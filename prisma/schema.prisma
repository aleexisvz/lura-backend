// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)

  readingSessions ReadingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mangaProgress MangaProgress[]
}

enum Role {
  USER
  ADMIN
}

model Manga {
  id        String   @id @default(cuid())
  title     String
  author    String?
  coverPath String?

  volumes   Volume[]

  createdAt DateTime @default(now())
}

model Volume {
  id         String   @id @default(cuid())
  mangaId    String
  number     Int
  title      String?
  status     VolumeStatus
  pagesCount Int      @default(0)

  pages      Page[]

  createdAt  DateTime @default(now())

  Manga Manga @relation(fields: [mangaId], references: [id])
}

model Page {
  id       String @id @default(cuid())
  volumeId String
  index    Int
  filename String

  Volume Volume @relation(fields: [volumeId], references: [id])
}

enum VolumeStatus {
  UPLOADING
  READY
}

model MangaProgress {
  id       String @id @default(cuid())
  
  userId   String
  mangaId  String
  volumeId String
  page     Int

  updatedAt DateTime @updatedAt
  
  User   User   @relation(fields: [userId], references: [id])
  
  @@unique([userId, mangaId])
  @@index([userId])
}

model ReadingSession {
  id              String             @id @default(cuid())

  userId          String
  contentType     ReadingContentType
  contentId       String

  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  User            User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, contentType])
  @@index([contentId])
}

enum ReadingContentType {
  MANGA
  BOOK
}