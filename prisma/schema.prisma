// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(USER)
  profileImagePath String?
  readingXpTotal Int @default(0)
  readingTimeTotalSeconds Int @default(0)
  readingTimeMangaSeconds Int @default(0)
  readingTimeBookSeconds  Int @default(0)
  readingSessionsCount    Int @default(0)

  readingSessions   ReadingSession[]
  mangaProgress     MangaProgress[]
  volumeCompletions VolumeCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum MangaStatus {
  EN_EMISION
  FINALIZADO
}

model Manga {
  id        String   @id @default(cuid())
  title     String
  titleKanji String?
  author    String?
  description String?
  coverPath String?
  status    MangaStatus @default(EN_EMISION)

  volumes   Volume[]
  mangaTags MangaTag[]
  mangaProgress MangaProgress[]

  createdAt DateTime @default(now())
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String?
  description String?
  coverPath   String?
  epubPath    String?

  bookTags    BookTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  scope     TagScope
  name      String
  slug      String

  mangaTags MangaTag[]
  bookTags  BookTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, slug])
}

enum TagScope {
  MANGA
  BOOK
}

model MangaTag {
  mangaId String
  tagId   String

  Manga Manga @relation(fields: [mangaId], references: [id])
  Tag   Tag   @relation(fields: [tagId], references: [id])

  @@id([mangaId, tagId])
  @@index([tagId])
}

model BookTag {
  bookId String
  tagId  String

  Book Book @relation(fields: [bookId], references: [id])
  Tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([bookId, tagId])
  @@index([tagId])
}

model Volume {
  id         String   @id @default(cuid())
  mangaId    String
  number     Int
  title      String?
  coverPath  String?
  status     VolumeStatus
  pagesCount Int      @default(0)

  pages             Page[]
  volumeCompletions VolumeCompletion[]
  mangaProgress     MangaProgress[]

  createdAt  DateTime @default(now())

  Manga Manga @relation(fields: [mangaId], references: [id])
}

model Page {
  id       String @id @default(cuid())
  volumeId String
  index    Int
  filename String

  Volume Volume @relation(fields: [volumeId], references: [id])

  @@unique([volumeId, index])
}

enum VolumeStatus {
  UPLOADING
  READY
}

model MangaProgress {
  id       String @id @default(cuid())
  
  userId   String
  mangaId  String
  volumeId String
  page     Int

  historicalPagesRead Int @default(0)

  updatedAt DateTime @updatedAt
  
  User   User   @relation(fields: [userId], references: [id])
  Manga  Manga  @relation(fields: [mangaId], references: [id])
  Volume Volume @relation(fields: [volumeId], references: [id])
  
  @@unique([userId, mangaId, volumeId])
  @@index([userId])
  @@index([userId, updatedAt])
}

model ReadingSession {
  id              String             @id @default(cuid())

  userId          String
  contentType     ReadingContentType
  contentId       String

  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  xpAwarded       Int?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  User            User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, contentType])
  @@index([contentId])
}

enum ReadingContentType {
  MANGA
  BOOK
}

model VolumeCompletion {
  id             String   @id @default(cuid())
  userId         String
  volumeId       String
  mangaId        String
  completedAt    DateTime @default(now())
  isActive       Boolean  @default(true)
  timesCompleted Int      @default(1)

  User   User   @relation(fields: [userId], references: [id])
  Volume Volume @relation(fields: [volumeId], references: [id])

  @@unique([userId, volumeId])
  @@index([userId])
}
